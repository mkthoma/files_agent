# Secrets: never commit (.env.local, .env.keystone, .env.bak, ...)
.env
.env.*
*.env
!.env.example

# Run output (traces can hold platform data; keep the folder, not the contents)
runs/*
!runs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local tool settings that can hold secrets (STRIDE I3): an AI assistant's saved allow rules, direnv
.claude/settings.local.json
.envrc

# Official server run output (regenerated every run)
results.json
