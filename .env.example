# Copy to .env and fill in. .env is git-ignored: never commit it.
# On Linux or macOS, make it private to you: cp .env.example .env && chmod 600 .env
# On Windows, keep the repo inside your own user folder, where other users can't read it.
# Never type these values on a command line: shell history keeps them (docs/checking.md, section 7.2, reads them from here).
# A space then '#' starts a comment, so put quotes around any value that contains " #",
# e.g. AS_KEYSTONE_PASSWORD='abc #123'.

AS_EMAIL=team20@theschoolofai.in
AS_KEYSTONE_PASSWORD=
AS_SURYODAYA_PASSWORD=

# Your own model key (the brief requires your own keys). Leave blank to use the
# offline scripted model only.
ANTHROPIC_API_KEY=
AS_MODEL=claude-sonnet-5

# Budget guard (per question). AS_MAX_USD must be a finite number of at least 0
# (nan and inf are refused).
AS_MAX_TURNS=12
AS_MAX_MCP_CALLS=80
AS_MAX_USD=0.50
# Price per million tokens, used for the cost ledger and the $ cap. Check your provider's
# pricing. Each must be above 0.
AS_PRICE_IN_PER_MTOK=3.0
AS_PRICE_OUT_PER_MTOK=15.0

# AS_ALLOW_WRITES is ignored in this file on purpose. Set it only in the shell, for the
# single deliberate live write run:
#   AS_ALLOW_WRITES=1 python -m harness run TI2L --target live --model anthropic --live-apply --set live-write

# actor_kind for the agent's AgentSession rows: 'user', 'system', or blank.
# 'agent' is not allowed by the platform. Leave blank until staff answer Q7.
AS_ACTOR_KIND=
